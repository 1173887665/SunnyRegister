# SunnyRegister production example
# 服务器部署建议：复制为 .env，设置强密码和随机 Worker Token。

SUNNYREGISTER_BIND=0.0.0.0
SUNNYREGISTER_PORT=8000
SUNNYREGISTER_TAG=latest
TZ=Asia/Shanghai

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
APP_PASSWORD=
PYTHON_WORKER_TOKEN=change-me-to-a-long-random-token
PYTHON_TASK_TYPES=sunny_register,sunny_login,sunny_refresh_session

# noVNC 无内置鉴权，默认仅监听宿主机 127.0.0.1。
# 远程查看浏览器窗口：ssh -L 6080:127.0.0.1:6080 user@server，然后访问 http://127.0.0.1:6080/vnc.html
ENABLE_XVFB=true
ENABLE_NOVNC=true
NOVNC_BIND=127.0.0.1
NOVNC_PORT=6080
XVFB_WHD=1600x900x24
