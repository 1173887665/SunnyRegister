# SunnyRegister production configuration
# Copy to .env on the server. Secrets are generated under ./secrets and are not committed.

SUNNYREGISTER_DOMAIN=register.example.com
SUNNYREGISTER_BIND=127.0.0.1
SUNNYREGISTER_PORT=8000
SUNNYREGISTER_TAG=latest
SUNNYREGISTER_PUBLIC_CHECK=false
TZ=Asia/Shanghai
SUNNY_TIMEZONE=Asia/Shanghai
SUNNY_HEALTHCHECK_ENABLED=true
SUNNY_HEALTHCHECK_TIME=06:00
SUNNY_HEALTHCHECK_CONCURRENCY=2

ADMIN_USERNAME=admin
POSTGRES_DB=sunnyregister
POSTGRES_USER=sunnyregister
# 原生部署使用；Docker 生产部署会自动生成 secrets/database_url。
DATABASE_URL=postgresql://sunnyregister:change-me-postgres-password@127.0.0.1:5432/sunnyregister?sslmode=disable
SUNNY_DB_MAX_OPEN_CONNS=30
SUNNY_DB_MAX_IDLE_CONNS=10
PYTHON_TASK_TYPES=sunny_register,sunny_login,sunny_refresh_session,sunny_acquire_rt,sunny_rebind

# MoMo wallet adapter and SMS source. Set these in the runtime secret store.
OPAI_MOMO_API_BASE_URL=
OPAI_MOMO_API_TOKEN=
OPAI_MOMO_API_HEADERS=
OPAI_MOMO_MOCK_MODE=0
OPAI_MOMO_PHONE_SOURCE=pool
OPAI_MOMO_PHONE_COUNTRY=84
OPAI_MOMO_PHONE_PREFIX=+84
OPAI_MOMO_SMS_COUNTRY=84
OPAI_MOMO_SMS_SERVICE=momo
OPAI_MOMO_SMS_API_BASE_URL=
OPAI_MOMO_SMS_API_KEY=
OPAI_MOMO_SMS_MAX_PRICE=
OPAI_MOMO_SMS_POOL=
OPAI_MOMO_PROXY_POOL=

# Visible-browser support stays on Xvfb. noVNC is disabled unless troubleshooting is needed.
ENABLE_XVFB=true
ENABLE_NOVNC=false
WORKER_DISPLAY=:99
NOVNC_BIND=127.0.0.1
NOVNC_PORT=6080
XVFB_WHD=1600x900x24
WORKER_SHM_SIZE=1gb

# Outlook OTP uses the registration task proxy first, then IPv4 direct. Set a
# dedicated HTTP CONNECT or SOCKS5 proxy here to override the task proxy.
OUTLOOK_IMAP_DIRECT_FIRST=false
OUTLOOK_IMAP_PROXY=
XBOVO_ICLOUD_MAX_CONCURRENCY=3
XBOVO_ICLOUD_POOL_RETRIES=4
XBOVO_ICLOUD_QUEUE_TIMEOUT=120
XBOVO_ICLOUD_LONG_POLL_SECONDS=10
