# SunnyRegister 本地与 Docker Compose 通用配置模板
# 复制为 .env 后按需修改。

# Web 服务监听
SUNNYREGISTER_BIND=0.0.0.0
SUNNYREGISTER_PORT=8000
SUNNYREGISTER_TAG=latest
TZ=Asia/Shanghai
SUNNY_TIMEZONE=Asia/Shanghai
SUNNY_HEALTHCHECK_ENABLED=true
SUNNY_HEALTHCHECK_TIME=06:00
SUNNY_HEALTHCHECK_CONCURRENCY=2
SUNNY_HEALTHCHECK_BATCH_SIZE=50
OUTLOOK_IMAP_DIRECT_FIRST=false
OUTLOOK_IMAP_PROXY=

# 管理员账号。留空 ADMIN_PASSWORD 时首次启动会自动生成密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_PASSWORD=

# 本地运行时数据库路径；Compose 会覆盖为容器内 /app/data/account_manager.db。
ACCOUNT_MANAGER_DATABASE_URL=sqlite:///./data/account_manager.db

# Python Worker
PYTHON_WORKER_URL=http://127.0.0.1:8765
PYTHON_WORKER_TOKEN=
PYTHON_TASK_TYPES=sunny_register,sunny_login,sunny_refresh_session

# 图形服务默认关闭以降低空闲资源占用；后台 Camoufox 无需 Xvfb。只有持续使用可视浏览器/noVNC 时才启用。
ENABLE_XVFB=false
ENABLE_NOVNC=false
WORKER_DISPLAY=:99
NOVNC_BIND=127.0.0.1
NOVNC_PORT=6080
XVFB_WHD=1600x900x24
WORKER_SHM_SIZE=1gb

# 可选：也可以在前端“反代配置”中填写。
SUB2API_BASE_URL=
SUB2API_ADMIN_TOKEN=
SUB2API_AUTH_HEADER=x-api-key
SUB2API_GROUP_ID=
SUB2API_GROUP_NAME=
