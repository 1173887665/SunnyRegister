# SunnyRegister 本地 / Docker Compose 通用配置模板
# 使用方式：复制为 .env 后按需修改：cp .env.example .env

# Web 服务监听
SUNNYREGISTER_BIND=0.0.0.0
SUNNYREGISTER_PORT=8000
SUNNYREGISTER_TAG=latest
TZ=Asia/Shanghai

# 管理员账号；不设置 ADMIN_PASSWORD 时，首次启动会自动生成并写入 Docker volume 中的 admin_password.txt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_PASSWORD=

# Go 后端本地启动时使用；Docker Compose 内部会覆盖为 /app/data/account_manager.db
ACCOUNT_MANAGER_DATABASE_URL=sqlite:///./data/account_manager.db

# Python Worker 本地启动时使用；Docker Compose 内部会覆盖为 http://python-worker:8765
PYTHON_WORKER_URL=http://127.0.0.1:8765
PYTHON_WORKER_TOKEN=
PYTHON_TASK_TYPES=sunny_register,sunny_login,sunny_refresh_session

# Linux/服务器 Docker 可视浏览器支持
# 容器内使用 Xvfb 创建虚拟显示；noVNC 用于在浏览器里查看/人工处理注册流程。
ENABLE_XVFB=true
ENABLE_NOVNC=true
NOVNC_BIND=127.0.0.1
NOVNC_PORT=6080
XVFB_WHD=1600x900x24

# 可选：Sub2API 默认连接信息，也可以在前端“反代配置”中填写
SUB2API_BASE_URL=
SUB2API_ADMIN_TOKEN=
SUB2API_AUTH_HEADER=x-api-key
SUB2API_GROUP_ID=
SUB2API_GROUP_NAME=
